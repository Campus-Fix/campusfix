        {
          "name": "Login (Sets {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.token) {",
                  "        pm.collectionVariables.set('token', res.data.token);",
                  "        pm.environment.set('token', res.data.token);",
                  "        console.log('JWT Token successfully set in {{token}} variable.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campusfix.edu\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
